# ─────────────────────────────────────────────────────────
# Enterprise Data Observability Platform — Environment File
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# --- Google Cloud Platform ---
# Your GCP project ID (used by dbt, BigQuery scripts, and Airflow DAG)
GCP_PROJECT_ID=your-gcp-project-id

# --- Airflow ---
# On Linux/macOS, set this to your user ID: $(id -u)
# On Windows, 50000 is usually fine
AIRFLOW_UID=50000

# --- Superset ---
# Generate a long random string for production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=change_me_to_a_random_string
