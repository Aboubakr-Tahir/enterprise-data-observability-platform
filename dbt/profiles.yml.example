# ─────────────────────────────────────────────────────────
# dbt Profiles Configuration Template
# ─────────────────────────────────────────────────────────
# Copy this file to profiles.yml and update with your values:
#   cp profiles.yml.example profiles.yml
#
# Required: Place your GCP service account key at the project root as gcp-key.json

my_dbt_project:
  target: dev
  outputs:
    # Local development target — uses the repo-root keyfile
    dev:
      type: bigquery
      method: service-account
      project: your-gcp-project-id          # ← Replace with your GCP project ID
      dataset: analytics
      threads: 4
      timeout_seconds: 300
      location: US
      priority: interactive
      keyfile: /path/to/your/gcp-key.json    # ← Absolute path to your key

    # Docker / Airflow target — uses the mounted secret path
    prod:
      type: bigquery
      method: service-account
      project: your-gcp-project-id          # ← Replace with your GCP project ID
      dataset: analytics
      threads: 4
      timeout_seconds: 300
      location: US
      priority: interactive
      keyfile: /secrets/gcp-key.json         # ← Do not change (Docker mount path)
